# Local development only. Never use these example values in production.
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL="postgresql://taskdesk:taskdesk_local@localhost:5432/taskdesk?schema=public"

# Explicit local-only bypass; rejected by production and Vercel runtimes.
NODE_ENV=development
AUTH_MODE=local
VITE_AUTH_MODE=local
# Hosted auth: set AUTH_MODE=supabase and omit VITE_AUTH_MODE.
# Publishable keys are public. Never put secret/service_role keys in VITE_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
