{
  "name": "taskdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Personal task management platform",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace @taskdesk/api\" \"npm run dev --workspace @taskdesk/web\"",
    "dev:api": "npm run dev --workspace @taskdesk/api",
    "dev:web": "npm run dev --workspace @taskdesk/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @taskdesk/api",
    "db:migrate": "npm run db:migrate --workspace @taskdesk/api",
    "db:studio": "npm run db:studio --workspace @taskdesk/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": { "node": ">=20.15.0", "npm": ">=10.0.0" }
}
